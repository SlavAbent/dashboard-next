{
  "name": "dashboard-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:studio": "prisma studio",
    "dev": "pnpm db:start && pnpm validate:db && concurrently \"pnpm backend\" \"pnpm json-server\"",
    "backend": "node ./backend/server.js",
    "json-server": "json-server ./backend/db/db.json --watch --port 4001",
    "build": "next build frontend",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "start": "NODE_ENV=production node ./backend/server.js",
    "validate:db": "node backend/scripts/validate-db.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "jest --runInBand",
    "test:components": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:snapshots": "jest --runInBand frontend/shared/components/componentSnapshots.test.tsx",
    "test:screenshots": "playwright test --config=playwright.visual.config.ts",
    "test:screenshots:update": "pnpm test:screenshots --update-snapshots",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "1.4.0",
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/react": "0.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/env": "^16.3.8",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "lucide-react": "1.7.0",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.78.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^15.5.6",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/nextjs-vite": "10.6.4",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "json-server": "^1.0.0-beta.14",
    "knip": "^5.66.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.9.1",
    "storybook": "10.6.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
