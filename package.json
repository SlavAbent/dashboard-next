{
  "name": "dashboard-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "db:start": "node backend/scripts/docker-compose.mjs start",
    "db:stop": "node backend/scripts/docker-compose.mjs stop",
    "db:logs": "node backend/scripts/docker-compose.mjs logs",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node backend/scripts/seed-legacy-data.ts",
    "dev": "pnpm db:start && pnpm db:generate && pnpm db:migrate && pnpm db:seed && pnpm backend",
    "backend": "node ./backend/server.js",
    "build": "next build frontend",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "start": "NODE_ENV=production node ./backend/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:backend && pnpm test:components",
    "test:unit": "jest --runInBand",
    "test:backend": "node --test backend/tests/backend.test.ts backend/tests/docker-compose.test.mjs",
    "test:components": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:snapshots": "jest --runInBand frontend/shared/components/componentSnapshots.test.tsx",
    "test:screenshots": "playwright test --config=playwright.visual.config.ts",
    "test:screenshots:update": "pnpm test:screenshots --update-snapshots",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "1.4.0",
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/react": "0.4.0",
    "@hookform/resolvers": "^5.9.2",
    "@next/env": "16.4.6",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/query-core": "5.108.1",
    "@tanstack/react-query": "5.108.1",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "lucide-react": "1.7.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "2.6.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.108.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "knip": "^5.66.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.10.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "^5"
  }
}
