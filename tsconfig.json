{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./frontend/*"],
      "@dashboard/pomodoro": ["./packages/pomodoro/src/index.ts"],
      "@dashboard/pomodoro/*": ["./packages/pomodoro/src/*"],
      "@dashboard/clock": ["./packages/clock/src/index.ts"],
      "@dashboard/weather": ["./packages/weather/src/index.ts"],
      "@dashboard/chat": ["./packages/chat/src/index.ts"],
      "@lib/*": ["./lib/*"],
      "@frontend/*": ["./frontend/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "frontend/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
