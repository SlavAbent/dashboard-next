{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@dashboard/pomodoro": ["../packages/pomodoro/src/index.ts"],
      "@dashboard/pomodoro/*": ["../packages/pomodoro/src/*"],
      "@dashboard/clock": ["../packages/clock/src/index.ts"],
      "@dashboard/weather": ["../packages/weather/src/index.ts"],
      "@dashboard/chat": ["../packages/chat/src/index.ts"],
      "@lib/*": ["../lib/*"],
      "@frontend/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "moduleResolution": "node"
  },
  "include": [
    "../global.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
